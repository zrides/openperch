# Copy to .env (git-ignored) and fill in.

# Login for the web UI and API (HTTP Basic). Required.
KIWIBIT_HUB_USER=kiwibit
KIWIBIT_HUB_PASSWORD=

# 127.0.0.1 = this PC only. 0.0.0.0 = reachable on your network (phone).
KIWIBIT_HUB_BIND=127.0.0.1
KIWIBIT_HUB_PORT=8000

# Host paths, relative to this folder.
KIWIBIT_DATA_DIR=./data
KIWIBIT_BIOCLIP_DIR=../bioclip-2.5-vith14
# Kiwibit account config (bearer token). Mounted read-only as a Docker secret.
KIWIBIT_ACCOUNT_CONFIG=../kiwibit-analysis/kiwibit-viewer/config.json
