# Copy to .env (git-ignored) and fill in.

# The owner account for the web UI and API: always an admin, who can add more accounts.
# Use a long random password. Required.
KIWIBIT_HUB_USER=admin
KIWIBIT_HUB_PASSWORD=

# 127.0.0.1 = this PC only. 0.0.0.0 = reachable on your network (phone).
KIWIBIT_HUB_BIND=127.0.0.1
KIWIBIT_HUB_PORT=8765

# Host paths, relative to this folder.
KIWIBIT_DATA_DIR=./data
# BioCLIP 2.5 weights (see README, "Set up").
KIWIBIT_BIOCLIP_DIR=./data/models/bioclip-2.5-vith14
# Your Kiwibit account file (see README). Mounted read-only as a Docker secret.
KIWIBIT_ACCOUNT_CONFIG=./secrets/kiwibit-account.json

# Detector weights under data/models, downloaded on first use. Re-analyze all
# recordings (Camera page) after changing it.
KIWIBIT_DETECTOR=yolov8x-worldv2.pt

# Live view media (WebRTC over UDP). Browsers connect to these addresses on this port.
# Put this PC's LAN address first: Firefox ignores 127.0.0.1 routes, and phones need it.
# Find it with: Get-NetIPAddress -AddressFamily IPv4  (e.g. 192.168.1.20)
KIWIBIT_LIVE_UDP_PORT=8766
KIWIBIT_LIVE_HOSTS=<LAN address>,127.0.0.1
KIWIBIT_LIVE_BIND=0.0.0.0

# Free the AI models' GPU memory (about 4 GB) after this many seconds without a job.
# The next job reloads them in about 20 seconds. 0 frees it right after each job.
KIWIBIT_GPU_IDLE_SECONDS=300
